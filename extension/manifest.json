{
  "manifest_version": 3,
  "name": "MyDM - Download Manager",
  "version": "2.0.0",
  "description": "An advanced, browser-native download manager featuring smart queueing, media detection, resume, and categorization.",
  "permissions": [
    "downloads",
    "downloads.open",
    "storage",
    "contextMenus",
    "activeTab",
    "scripting",
    "clipboardRead",
    "nativeMessaging",
    "cookies"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*",
        "http://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "MyDM Download Manager",
    "default_icon": {
      "48": "icon48.png"
    }
  },
  "icons": {
    "48": "icon48.png"
  }
}
